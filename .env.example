#===============================================================================
# SXT Validator Dashboard - Configuration
#
# Generated automatically by ./install.sh on first install.
# You can edit values here and run `./start.sh restart` to apply.
#
# Note: do NOT quote values.  Compose parses this file with its own
# dialect that does not honour shell quoting.
#===============================================================================

# -----------------------------------------------------------------------------
# Validator identity (REQUIRED)
# -----------------------------------------------------------------------------
# Display name of *your* validator as it appears in the SXT staking API
# (https://staking.spaceandtime.io/api/validator).  Drives the "Operator
# earnings" row of the dashboard.  install.sh validates this against
# the live network so it must match an existing validator.
SXT_LOCAL_VALIDATOR=

# -----------------------------------------------------------------------------
# Node connection (REQUIRED)
# -----------------------------------------------------------------------------
# RPC endpoint of your SXT validator.  Defaults below assume the dashboard
# stack runs on the validator host itself; for a remote dashboard set these
# to the validator's public IP and open the corresponding firewall ports.
SXT_RPC_URL=http://172.17.0.1:9944
SXT_PROMETHEUS_TARGET=172.17.0.1:9615
NODE_EXPORTER_TARGET=172.17.0.1:9100

# Mountpoint where SXT chain data is stored (find with `df -h`).
# Used by the "Host resources" row to track disk usage.
SXT_DATA_MOUNTPOINT=/sxt-data

# -----------------------------------------------------------------------------
# Exporter
# -----------------------------------------------------------------------------
SXT_EXPORTER_POLL_INTERVAL=12
SXT_EXPORTER_PORT=9101
SXT_EXPORTER_LOG_LEVEL=INFO
SXT_STAKING_POLL_INTERVAL=120
SXT_PRICE_POLL_INTERVAL=300

# -----------------------------------------------------------------------------
# Stack ports (host side) — change if any of these collide on your machine
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Compose project name. Change this if you want to run more than one
# stack on the same host (e.g. testnet + mainnet).
COMPOSE_PROJECT_NAME=sxt-validator-dashboard

# -----------------------------------------------------------------------------
# Prometheus
# -----------------------------------------------------------------------------
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_RETENTION=30d

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# 127.0.0.1 = localhost only (recommended; expose via reverse proxy).
# Set 0.0.0.0 to publish directly on GRAFANA_PORT (no TLS — discouraged).
GRAFANA_BIND=127.0.0.1

# -----------------------------------------------------------------------------
# ClickHouse — two-user model
# -----------------------------------------------------------------------------
# sxt_exporter writes data (INSERT/SELECT, capped at 4 GB / 120s per query).
# sxt_dashboard is the read-only user that Grafana uses (SELECT only,
# capped at 2 GB / 30s per query, readonly=1).
CLICKHOUSE_USER=sxt_exporter
CLICKHOUSE_PASSWORD=
SXT_DASHBOARD_USER=sxt_dashboard
SXT_DASHBOARD_PASSWORD=
